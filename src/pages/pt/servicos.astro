---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import PageHeader from "../../components/PageHeader.astro";

const lang = "pt";
const currentPath = "/pt/servicos/";

const services = [
  {
    icon: "🌍",
    title:
      "Organização completa de excursões e peregrinações na Polónia e no mundo",
    description:
      "Organização completa de viagens de grupo turísticas e de peregrinação",
  },
  {
    icon: "🚌",
    title: "Aluguer de autocarros no país e no estrangeiro",
    description: "Autocarros modernos com motoristas experientes",
  },
  {
    icon: "🏨",
    title: "Reserva de alojamento e restauração",
    description: "Base hoteleira e de restaurantes verificada em todo o mundo",
  },
  {
    icon: "🎟️",
    title:
      "Ajuda na compra de bilhetes para museus e outras atrações turísticas",
    description: "Reservas sem filas para os lugares mais populares",
  },
  {
    icon: "🎯",
    title:
      "Organização de viagens de integração, conferências e formação no país e no estrangeiro",
    description: "Serviço integral para eventos corporativos",
  },
  {
    icon: "⛷️",
    title: "Viagens e campos de esqui",
    description: "Organização de viagens desportivas de inverno",
  },
  {
    icon: "🎧",
    title: "Aluguer de sistemas de auscultadores para grupos turísticos",
    description: "Sets profissionais de guia turístico",
  },
  {
    icon: "✨",
    title: "E qualquer outro serviço sob encomenda",
    description: "Abordagem individual para cada encomenda",
  },
];
---

<Layout title="Os nossos serviços" lang={lang}>
  <Header lang={lang} currentPath={currentPath} />

  <PageHeader
    title="Os nossos serviços"
    subtitle="Serviços turísticos abrangentes para grupos organizados"
    backgroundImage="/images/zdjcienagaleriHOME2.jpg"
  />

  <main>
    <section class="intro-section">
      <div class="container">
        <div class="intro-content">
          <p>
            A nossa oferta dirige-se principalmente a organizadores turísticos,
            agências de viagens e outras entidades que organizam viagens em
            grupo, como paróquias, escolas ou associações.
          </p>
          <p>
            Proporcionamos um serviço profissional e assistência na criação de
            viagens no país e no estrangeiro. Reservamos todos os serviços
            necessários para a realização de qualquer tipo de evento turístico.
          </p>
          <p>
            A nossa equipa está aberta a comentários e sugestões da sua parte, e
            a satisfação do cliente é a nossa prioridade. Bons serviços e um
            programa ótimo são metade do sucesso, completado pela colaboração
            com especialistas em cada etapa da criação e realização da viagem.
          </p>
        </div>
      </div>
    </section>

    <section class="services-section">
      <div class="container">
        <h2>O que oferecemos</h2>
        <div class="services-grid">
          {services.map((service) => (
            <div class="service-card">
              <div class="service-icon">{service.icon}</div>
              <h3>{service.title}</h3>
              <p>{service.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</Layout>

<style>
.intro-section {
  padding: 4rem 0;
  background: var(--bg-light);
}

.intro-content {
  max-width: 800px;
  margin: 0 auto;
}

.intro-content p {
  font-size: 1.1rem;
  line-height: 1.8;
  margin-bottom: 1.5rem;
  color: var(--text-color);
}

.services-section {
  padding: 4rem 0;
}

.services-section h2 {
  text-align: center;
  font-size: 2rem;
  color: var(--primary-color);
  margin-bottom: 3rem;
}

.services-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 1.5rem;
}

.service-card {
  background: white;
  padding: 2rem;
  border-radius: 12px;
  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
  border: 1px solid var(--border-color);
  transition:
    transform 0.3s,
    box-shadow 0.3s;
}

.service-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 8px 25px rgba(0, 0, 0, 0.12);
}

.service-icon {
  font-size: 3rem;
  margin-bottom: 1rem;
}

.service-card h3 {
  color: var(--primary-color);
  font-size: 1.1rem;
  margin-bottom: 0.75rem;
  line-height: 1.4;
}

.service-card p {
  color: var(--text-light);
  font-size: 0.95rem;
  margin: 0;
}
</style>
